# direnv config — auto-loads .env on `cd` into this directory.
#
# One-time setup:
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc   # (or bash equivalent)
#   direnv allow .                                  # approve this .envrc
#
# After that, `cd` here exports everything from .env so you can run
# `make deploy` without a long `PROJECT_ID=... REGION=...` prefix.

dotenv_if_exists .env

# Activate the project venv automatically (optional but convenient)
if [ -d .venv ]; then
  source .venv/bin/activate
fi
